{
  "name": "@apex/migration",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx src/runner.ts",
    "migrate:extract": "tsx src/runner.ts --phase extract",
    "migrate:validate": "tsx src/runner.ts --phase validate",
    "migrate:promote": "tsx src/runner.ts --phase promote",
    "migrate:reconcile": "tsx src/runner.ts --phase reconcile"
  },
  "dependencies": {
    "@apex/database": "workspace:*",
    "@apex/types": "workspace:*",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
